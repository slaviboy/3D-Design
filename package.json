{
  "name": "planar",
  "private": true,
  "version": "0.1.0",
  "description": "Offline, local-first browser 3D modeling application",
  "license": "Apache-2.0",
  "author": "Stanislav Georgiev (https://github.com/slaviboy)",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.kernel.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run --testTimeout=600000",
    "bench:render": "vite build --mode e2e && playwright test -c playwright.perf.config.ts",
    "build": "npm run typecheck && vite build",
    "build:local": "npm run typecheck && vite build --base=./ --mode static",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "vite build --mode e2e && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run e2e"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robust-predicates": "^3.0.3",
    "three": "^0.186.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
